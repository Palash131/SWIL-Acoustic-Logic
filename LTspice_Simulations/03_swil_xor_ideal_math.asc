Version 4
SHEET 1 3200 2000
TEXT 80 48 Left 6 SWIL XOR Gate (ULTRA-WIDEBAND OPTIMIZED)
TEXT 80 112 Left 3 ;Strain Wave Interference Logic — LTspice Electrical Equivalent
TEXT 80 160 Left 2 ;Substrate: LiNbO3 | f0 = 10 MHz | v_SAW = 3979 m/s
TEXT 80 192 Left 2 ;Path lengths: EQUAL (300ns). Phase shift done by inverting IDT_B.
TEXT 80 240 Left 2 ;══════════════════════════════════════════════════════════════
TEXT 80 272 Left 2 ;TRUTH TABLE (shown sequentially in transient sim):
TEXT 80 304 Left 2 ;  t=0-1µs:  A=0 B=0  →  V(INT)~0   →  XOR=0
TEXT 80 336 Left 2 ;  t=1-3µs:  A=1 B=0  →  V(INT) full (A only)  →  XOR=1
TEXT 80 368 Left 2 ;  t=3-5µs:  A=0 B=1  →  V(INT) full (B only)  →  XOR=1
TEXT 80 400 Left 2 ;  t=5-7µs:  A=1 B=1  →  V(INT)~0 (destructive!)  →  XOR=0
TEXT 80 432 Left 2 ;  t=7-8µs:  A=0 B=0  →  V(INT)~0  →  XOR=0
TEXT 80 480 Left 2 ;══════════════════════════════════════════════════════════════
TEXT 80 512 Left 3 ;── INPUT A  (0° reference path) ──────────────────────────────
TEXT 80 544 Left 2 !* Input A: 10MHz carrier, active during t=[1µs,3µs] and t=[5µs,7µs]
TEXT 80 576 Left 2 !B_A   VA  0  V=sin(2*pi*10Meg*time)*(((time>1u)&(time<3u))|((time>5u)&(time<7u)))
TEXT 80 608 Left 2 ;
TEXT 80 640 Left 2 !* IDT_A: Ultra-Wideband (Low-Q) BVD model (instant physical response)
TEXT 80 704 Left 2 !Lm_A  VA   NL_A   0.397u 
TEXT 80 736 Left 2 !Cm_A  NL_A NC_A   636p  
TEXT 80 768 Left 2 !Rm_A  NC_A MA     50     
TEXT 80 832 Left 2 ;
TEXT 80 864 Left 2 !* Acoustic propagation — Path A: 3λ = 300 ns
TEXT 80 896 Left 2 !T_A   MA  0    INT  0    Z0=50 Td=300n
TEXT 80 944 Left 2 ;══════════════════════════════════════════════════════════════
TEXT 80 976 Left 3 ;── INPUT B  (INVERTED IDT FINGERS for 180° shift) ────────────
TEXT 80 1008 Left 2 !B_B   VB  0  V=-sin(2*pi*10Meg*time)*(((time>3u)&(time<5u))|((time>5u)&(time<7u)))
TEXT 80 1104 Left 2 ;
TEXT 80 1136 Left 2 !* IDT_B: Ultra-Wideband (Low-Q) BVD model
TEXT 80 1168 Left 2 !Lm_B  VB   NL_B   0.397u
TEXT 80 1184 Left 2 !Cm_B  NL_B NC_B   636p
TEXT 80 1200 Left 2 !Rm_B  NC_B MB     50
TEXT 80 1264 Left 2 ;
TEXT 80 1296 Left 2 !* Acoustic propagation — Path B: EXACTLY EQUAL TO PATH A (300 ns)
TEXT 80 1360 Left 2 !T_B   MB   0    INT  0   Z0=50 Td=300n
TEXT 80 1472 Left 2 ;══════════════════════════════════════════════════════════════
TEXT 80 1504 Left 3 ;── INTERFERENCE NODE (INT) ──────────────────────────────────
TEXT 80 1648 Left 2 ;══════════════════════════════════════════════════════════════
